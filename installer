set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    echo "Please run as root: sudo ./installer"
    exit 1
fi

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
cd "$SCRIPT_DIR"

if [ -f /etc/debian_version ]; then
    apt-get update
    apt-get install -y python3 python3-pip
elif [ -f /etc/redhat-release ] || [ -f /etc/anolis-release ] ||
    [ -f /etc/openEuler-release ] || [ -f /etc/centos-release ] ||
    [ -f /etc/rocky-release ]; then
    yum install -y python3 python3-pip
else
    echo "Unsupported distribution"
    exit 1
fi

# The host pip config may point at a mirror that does not respond.
# Probe it briefly, then fall back to pypi.org.
PIP_INDEX_ARGS=()
MIRROR_URL=$(python3 - <<'PY'
import configparser, os
paths = ["/etc/pip.conf", "/etc/xdg/pip/pip.conf", os.path.expanduser("~/.pip/pip.conf"), os.path.expanduser("~/.config/pip/pip.conf")]
url = ""
for path in paths:
    if not os.path.isfile(path):
        continue
    cfg = configparser.ConfigParser()
    cfg.read(path)
    if cfg.has_option("global", "index-url"):
        url = cfg.get("global", "index-url").strip()
print(url)
PY
)

if [ -n "$MIRROR_URL" ]; then
    if timeout 8 curl -fsI --max-time 6 "$MIRROR_URL" >/dev/null 2>&1; then
        echo "Using pip index: $MIRROR_URL"
    else
        echo "Pip index is unreachable ($MIRROR_URL); using https://pypi.org/simple"
        PIP_INDEX_ARGS=(
            --index-url https://pypi.org/simple
            --trusted-host pypi.org
            --trusted-host files.pythonhosted.org
            --trusted-host pypi.python.org
        )
    fi
fi

pip3 install --timeout 60 "${PIP_INDEX_ARGS[@]}" termcolor pyinstaller

python3 -m PyInstaller --onefile --clean --name check-diff check-diff.py

install -m 755 dist/check-diff /usr/bin/check-diff
rm -rf build dist check-diff.spec

echo "Installation complete. You can now use 'check-diff' command."
